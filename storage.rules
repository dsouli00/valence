rules_version = '2';

// Valence Firebase Storage rules.
//
// The app stores exactly one kind of file: client meal photos, uploaded from
// the log-meal flow to meal_images/{clientId}/{timestamp}.jpg.
//
// READ IS NOW OWNER-ONLY. The old rule allowed any signed-in user to read —
// which, because `read` also governs `list`, let any account enumerate and
// download another client's food photos by walking the folder.
//
// THE COACH STILL SEES MEAL PHOTOS, and not through this rule: `Meal.imageUrl`
// is a tokenised `getDownloadURL()` link, and those bypass Storage rules by
// design. That token lives only inside the daily_logs document, which is now
// itself restricted to the client and their coach — so the capability travels
// exactly as far as it should. Do NOT loosen this rule "so the coach can see
// photos"; the coach can already see them, and loosening it re-opens the
// folder walk.
//
// Deploy:  firebase deploy --only storage --project valence-d72c4

service firebase.storage {
  match /b/{bucket}/o {

    match /meal_images/{clientId}/{fileName} {
      // Owner only. Covers `list`, which is what account-deletion's
      // deleteAllMealPhotos() needs on the client's own folder.
      allow read: if request.auth != null && request.auth.uid == clientId;

      allow create, update: if request.auth != null
        && request.auth.uid == clientId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == clientId;
    }

    // Deny-by-default for any other path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
